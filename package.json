{
  "name": "sketchy",
  "version": "1.0.0",
  "description": "A free realtime multiplayer draw-and-guess game",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env.local dev/server.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:apply": "tsx --env-file-if-exists=.env.local scripts/db-apply.ts"
  },
  "author": "Steven Widinata",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dynapuff": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@supabase/supabase-js": "2.119.2",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.10",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
